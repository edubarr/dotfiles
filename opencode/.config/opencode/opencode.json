{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "openai/gpt-5.6-sol",
  "default_agent": "orchestrator",
  "plugins": [
    "@tarquinen/opencode-dcp@latest"
  ],
  "username": "SlopCoder",
  "compaction": {
    "auto": true
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      }
    }
  },
  "agents": {
    "title": {
      "model": "opencode-go/glm-5.3-flash"
    },
    "explore": {
      "model": "opencode-go/glm-5.3-flash",
      "steps": 10
    },
    "general": {
      "model": "opencode-go/glm-5.3-flash",
      "steps": 24
    },
    "scout": {
      "description": "Researches current external documentation, dependency source, and upstream examples without modifying files.",
      "mode": "subagent",
      "model": "opencode-go/glm-5.3-flash",
      "steps": 10,
      "system": "Research only the requested external documentation, dependency source, or upstream examples. Return concise, actionable findings with source URLs or file references. Do not edit files, run tests, or repeat repository exploration already supplied by the parent.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}
